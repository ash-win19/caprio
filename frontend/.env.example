# Environment template for the frontend.
#
# Vite: variables must be prefixed with `VITE_` to be available in the browser.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# Must match the Auth0 API Identifier configured as AUTH0_AUDIENCE on the backend.
VITE_AUTH0_AUDIENCE=

# Optional local/demo environments only. Production defaults to authenticated users.
VITE_ENABLE_DEMO=false
