GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
# Mastra storage: Postgres, in the `mastra` schema. Local development points at
# the Neon dev database (its pooled connection string), never a clone; tests use
# a local Postgres. The server refuses to start without it.
MASTRA_DATABASE_URL=
# Planner tools call back into the Go backend. The secret must match the
# backend's PLANNER_TOOL_SECRET.
CAPRIO_BACKEND_URL=http://localhost:8080
PLANNER_TOOL_SECRET=
